# Base Postgres (Neon). Copier les deux valeurs depuis le tableau de bord Neon
# ou depuis Vercel > Storage > votre base > onglet ".env.local".
DATABASE_URL="postgresql://utilisateur:motdepasse@hote-pooler.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require"

# Mot de passe de l'espace /admin : a remplacer par une valeur longue et unique
ADMIN_PASSWORD="changez-moi"
