generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Connexion « poolée » utilisée par l'application.
  url       = env("DATABASE_URL")
  /// Connexion directe utilisée par `prisma db push` pour créer les tables.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Une ligne par participant (questionnaire complet ou screen-out).
/// Les modalités sont stockées sous forme de codes texte, listés dans
/// src/lib/survey.ts (pas d'enum en base : le questionnaire reste modifiable
/// sans migration).
model Response {
  id           Int    @id @default(autoincrement())
  respondentId String @unique

  /// "completed" | "screened_out_q2" ("screened_out_q1" : ancien statut, plus produit)
  status          String
  /// "A" (prix seul) | "B" (prix de référence barré + remise) ; montants dans src/lib/survey.ts
  assignedVersion String

  startedAt       DateTime
  submittedAt     DateTime @default(now())
  durationSeconds Int

  // Partie 1 : pratique outdoor
  q1Pratique       String
  q2Randonnee      String?
  q2Trail          String?
  q2Ski            String?
  q2Alpinisme      String?
  q2Vtt            String?
  q2Nautique       String?
  q2Camping        String?
  q2Autre          String?
  q2AutreTexte     String?
  q3SportPrincipal String?
  q3SportLibelle   String?
  q4Niveau         String?

  // Partie 2 : habitudes d'achat
  q5AchatVeste String?
  q5bBudget    String?
  q6Rang1      String?
  q6Rang2      String?
  q6Rang3      String?

  // Partie 3 : produit
  marqueConnue String?

  // Partie 4 : qualité perçue (échelles de 1 à 5, 5 = perception la plus favorable)
  qpFiabilite   Int?
  qpFabrication Int?
  qpQualite     Int?
  qpConfiance   Int?
  qpDurabilite  Int?

  // Anciennes mesures, remplacées par les 5 items de qualité perçue : conservées
  // pour ne perdre aucune donnée, absentes du CSV.
  intentionAchat Int?
  qualitePercue  Int?
  promoQualite   Int?
  recommandation Int?

  // Van Westendorp (en euros)
  vwTropBonMarche Int?
  vwBonneAffaire  Int?
  vwCher          Int?
  vwTropCher      Int?

  // Gabor-Granger
  gg99    String?
  gg129   String?
  gg179   String?
  gg195   String?
  /// Ancien palier 199 €, remplacé par 195 € : conservé pour ne perdre aucune donnée, absent du CSV.
  gg199   String?
  gg239   String?
  gg259   String?
  /// Ordre d'affichage des paliers pour ce répondant (croissant : "99|129|179|195|239|259")
  ggOrdre String?

  // Manipulation check
  manipCheck          String?
  isValidManipulation Boolean?

  // Partie 5 : profil
  genre         String?
  age           Int?
  situation     String?
  /// 500 = « 500 € et plus »
  budgetLoisirs Int?

  @@index([status])
  @@index([assignedVersion])
}
